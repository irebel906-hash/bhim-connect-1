{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "email", "role"]
    },
    "News": {
      "title": "News",
      "description": "News article",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "authorId": { "type": "string" },
        "likesCount": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["title", "content", "authorId"]
    },
    "Job": {
      "title": "Job",
      "description": "Job listing",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "company": { "type": "string" },
        "location": { "type": "string" },
        "type": { "type": "string" },
        "category": { "type": "string", "enum": ["government", "private"] },
        "description": { "type": "string" },
        "applyUrl": { "type": "string" },
        "authorId": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["title", "company", "description", "authorId"]
    },
    "Scheme": {
      "title": "Scheme",
      "description": "Government scheme",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "eligibility": { "type": "string" },
        "category": { "type": "string" },
        "link": { "type": "string" },
        "authorId": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["title", "description", "authorId"]
    },
    "Business": {
      "title": "Business",
      "description": "Business listing",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "contact": { "type": "string" },
        "address": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["name", "category", "contact", "ownerId"]
    },
    "Matrimonial": {
      "title": "Matrimonial",
      "description": "Matrimonial profile",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "gender": { "type": "string" },
        "dob": { "type": "string" },
        "education": { "type": "string" },
        "profession": { "type": "string" },
        "location": { "type": "string" },
        "about": { "type": "string" },
        "photoUrl": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["fullName", "gender", "dob", "ownerId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles including their role (e.g., admin or normal user)."
    },
    "/news/{newsId}": {
      "schema": { "$ref": "#/entities/News" },
      "description": "Stores news items created by admins."
    },
    "/jobs/{jobId}": {
      "schema": { "$ref": "#/entities/Job" },
      "description": "Stores job listings."
    },
    "/schemes/{schemeId}": {
      "schema": { "$ref": "#/entities/Scheme" },
      "description": "Stores government schemes."
    },
    "/businesses/{businessId}": {
      "schema": { "$ref": "#/entities/Business" },
      "description": "Stores business directory listings."
    },
    "/matrimonial/{profileId}": {
      "schema": { "$ref": "#/entities/Matrimonial" },
      "description": "Stores matrimonial profiles."
    }
  }
}
